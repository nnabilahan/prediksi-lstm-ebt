# Audit pipeline: intermediate binaries (models/scalers/zip) regenerated by
# audit/run_pipeline*.py -- kept locally, not committed (large, reproducible).
# Small CSV outputs under audit/results/ ARE committed.
audit/results/pipeline_run*/*.zip
audit/results/pipeline_run*/model_final/
audit/results/pipeline_run*/EBT_LSTM_Streamlit/models/
audit/results/pipeline_run*/EBT_LSTM_Streamlit/scalers/

# Cadangan model lama sebelum retrain (arsip lokal, jangan di-commit).
_backup_model_lama/

__pycache__/
*.pyc

# Backend: database lokal hasil migrasi (regenerate dengan
# `python backend/migrate_csv.py`, jadi tidak perlu ikut di-commit).
backend/*.db

# Cadangan database hasil pembersihan manual -- jangan ikut di-commit.
backend/*.db.backup-*
