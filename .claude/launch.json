{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "siprebar-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--host"],
      "port": 5173,
      "autoPort": true,
      "cwd": "."
    },
    {
      "name": "siprebar-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--reload", "--port", "8000"],
      "port": 8000,
      "cwd": "./backend"
    }
  ]
}
